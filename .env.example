# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database driver ---
# Choose "mongo" or "postgres". For a real project, delete this variable,
# delete the unused folder under src/shared/db/, and hardcode the choice
# in src/shared/db/index.ts.
DB_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017/arc_boilerplate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arc_boilerplate

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-random-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_MS=2592000000
BCRYPT_COST=12

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
