# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database driver ---
# Choose "mongo" or "postgres". For a real project, delete this variable,
# delete the unused folder under src/shared/db/, and hardcode the choice
# in src/shared/db/index.ts.
DB_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017/arc_boilerplate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arc_boilerplate

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-random-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_MS=2592000000
BCRYPT_COST=12

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Email ---
# Application URL for email links (used in verification and password reset emails)
APP_URL=http://localhost:5000
# Email driver: "console" (logs to stdout) or "smtp" (requires SMTP_* settings)
MAIL_DRIVER=console
# Sender email address
MAIL_FROM=ARC <no-reply@example.com>
# SMTP settings (required when MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=username
# SMTP_PASS=password
# SMTP_SECURE=false
# Token TTLs (in milliseconds)
VERIFY_TOKEN_TTL_MS=86400000
RESET_TOKEN_TTL_MS=3600000

# --- Queue ---
# Queue driver: "inline" (in-process, default) or "bullmq" (requires Redis)
QUEUE_DRIVER=inline
# Redis connection URL (required when QUEUE_DRIVER=bullmq)
# REDIS_URL=redis://localhost:6379
